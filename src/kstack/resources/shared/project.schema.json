{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kstack:project:1",
  "title": "Kstack Project v1",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "app_version",
    "metadata",
    "analysis",
    "visualization",
    "clusters",
    "homolog_groups",
    "pairwise_hits",
    "layout",
    "color_overrides",
    "fasta_selection"
  ],
  "properties": {
    "format": {
      "const": "Kstack"
    },
    "schema_version": {
      "const": 1
    },
    "app_version": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": [
        "created",
        "modified",
        "title"
      ],
      "properties": {
        "created": {
          "type": "string"
        },
        "modified": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "analysis_provenance": {
          "type": "object"
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "identity",
        "coverage",
        "preserve_input"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/fraction"
        },
        "coverage": {
          "$ref": "#/$defs/fraction"
        },
        "preserve_input": {
          "type": "boolean"
        }
      }
    },
    "visualization": {
      "type": "object",
      "required": [
        "connectors",
        "connector_identity",
        "labels"
      ],
      "properties": {
        "connectors": {
          "type": "boolean"
        },
        "connector_identity": {
          "$ref": "#/$defs/fraction"
        },
        "labels": {
          "type": "boolean"
        },
        "width_scale": {
          "type": "number", "minimum": 0.25, "maximum": 4, "default": 1
        },
        "height_scale": {
          "type": "number", "minimum": 0.25, "maximum": 4, "default": 1
        },
        "row_spacing_scale": {
          "type": "number", "minimum": 0.25, "maximum": 4, "default": 1
        }
      }
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/cluster"
      }
    },
    "homolog_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "members",
          "generated_color"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "generated_color": {
            "$ref": "#/$defs/color"
          }
        }
      }
    },
    "pairwise_hits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hit"
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "order",
        "rows"
      ],
      "properties": {
        "order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "rows": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "orientation",
              "offset"
            ],
            "properties": {
              "orientation": {
                "enum": [
                  1,
                  -1
                ]
              },
              "offset": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "color_overrides": {
      "type": "object",
      "required": [
        "genes",
        "groups"
      ],
      "properties": {
        "genes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/color"
          }
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/color"
          }
        }
      }
    },
    "fasta_selection": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cluster": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source_name",
        "accession",
        "length",
        "topology",
        "annotations",
        "cds",
        "warnings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "source_name": {
          "type": "string"
        },
        "accession": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "topology": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "cds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cds"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linearized_at_origin": {
          "type": "boolean"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "sequence"
            ]
          },
          {
            "required": [
              "nucleotide"
            ]
          }
        ]
      }
    },
    "cds": {
      "type": "object",
      "required": [
        "id",
        "cluster_id",
        "gene",
        "locus_tag",
        "product",
        "segments",
        "location",
        "strand",
        "cds_length",
        "protein",
        "protein_length",
        "translation_source",
        "partial",
        "warnings",
        "qualifiers",
        "group_id",
        "origin_spanning"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cluster_id": {
          "$ref": "#/$defs/id"
        },
        "gene": {
          "type": "string"
        },
        "locus_tag": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "strand"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "strand": {
                "enum": [
                  -1,
                  0,
                  1
                ]
              }
            }
          }
        },
        "location": {
          "type": "string"
        },
        "strand": {
          "enum": [
            -1,
            0,
            1
          ]
        },
        "cds_length": {
          "type": "integer",
          "minimum": 0
        },
        "protein": {
          "type": "string",
          "pattern": "^[A-Z*]*$"
        },
        "protein_length": {
          "type": "integer",
          "minimum": 0
        },
        "translation_source": {
          "enum": [
            "translation",
            "calculated",
            "unavailable"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualifiers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "group_id": {
          "$ref": "#/$defs/id"
        },
        "origin_spanning": {
          "type": "boolean"
        }
      }
    },
    "hit": {
      "type": "object",
      "required": [
        "query",
        "target",
        "identity",
        "alignment_length",
        "query_length",
        "target_length",
        "query_coverage",
        "target_coverage",
        "shorter_coverage",
        "bits",
        "evalue"
      ],
      "properties": {
        "query": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "identity": {
          "$ref": "#/$defs/fraction"
        },
        "alignment_length": {
          "type": "integer",
          "minimum": 1
        },
        "query_length": {
          "type": "integer",
          "minimum": 1
        },
        "target_length": {
          "type": "integer",
          "minimum": 1
        },
        "query_coverage": {
          "$ref": "#/$defs/fraction"
        },
        "target_coverage": {
          "$ref": "#/$defs/fraction"
        },
        "shorter_coverage": {
          "$ref": "#/$defs/fraction"
        },
        "bits": {
          "type": "number"
        },
        "evalue": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
